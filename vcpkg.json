{
  "name": "shr",
  "version-string": "0.1.0",
  "features": {
    "core-dsp": {
      "description": "Build the portable deterministic audio renderer.",
      "dependencies": [
        "pocketfft"
      ]
    },
    "scripts": {
      "description": "Install Papyrus sources for this program to develop on top of it."
    },
    "scripts-dev": {
      "description": "Install Papyrus sources necessary to develop scripts for this plugin.",
      "dependencies": [
        "bethesda-skyrim-scripts",
        {
          "name": "skse",
          "default-features": false,
          "features": [
            "scripts"
          ]
        }
      ]
    },
    "plugin": {
      "description": "Build the SKSE plugin.",
      "dependencies": [
        "toml11",
        "spdlog",
        "directxtk",
        "fmt",
        "pocketfft",
        "rapidcsv",
        "xbyak"
      ]
    },
    "tests": {
      "description": "Build tests for the SKSE plugin.",
      "dependencies": [
        {
          "name": "shr",
          "default-features": false,
          "features": [
            "plugin"
          ]
        },
        "catch2"
      ]
    }
  },
  "default-features": [
    "plugin",
    "tests"
  ]
}
